# Opteco — نمونهٔ Environment Variables
# این فایل را کپی کنید به .env.local و مقادیر واقعی را در Vercel/محیط محلی خودتان قرار دهید.
# هرگز .env.local را commit نکنید (در .gitignore قرار دارد).

# --- Supabase (Server-side, بدون NEXT_PUBLIC — هرگز به Browser نمی‌رود) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Supabase (Client-side — این دو مقدار عمداً Public هستند، امنیت از RLS می‌آید) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# --- Market API (Phase 2 — هنوز نهایی نشده) ---
# Provider نهایی هنوز تعیین نشده؛ این مقادیر فعلاً خالی/Placeholder هستند.
MARKET_API_BASE_URL=
MARKET_API_KEY=
